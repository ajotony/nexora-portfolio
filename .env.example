
# ============================================================
# NEXORA
# Environment Configuration Example
# ============================================================
#
# Local development configuration.
#
# Copy this file to .env and replace the placeholder values.
# Never commit real credentials or production secrets.
#
# Production configuration is managed through GitHub Actions,
# Ansible and Docker Swarm.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_ENV=development
ENVIRONMENT=development

# NestJS API listening port
PORT=8080

# Frontend API endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080

# Comma-separated allowed browser origins
CORS_ORIGIN=http://localhost:3000


# ------------------------------------------------------------
# POSTGRESQL
# ------------------------------------------------------------

# PostgreSQL container initialization
POSTGRES_DB=nexora
POSTGRES_USER=nexora_user
POSTGRES_PASSWORD=CHANGE_ME

# Application and worker database connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nexora
DB_USER=nexora_user
DB_PASSWORD=CHANGE_ME

# Optional alternative database connection string
# When configured, the worker uses DATABASE_URL
# instead of the individual DB_* variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE


# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379

# Optional alternative Redis connection string
# REDIS_URL=redis://redis:6379/0


# ------------------------------------------------------------
# CELERY
# ------------------------------------------------------------

# Default Celery queue
CELERY_QUEUE=celery

# Celery Publisher service endpoint
CELERY_PUBLISHER_URL=http://celery-publisher:8090
