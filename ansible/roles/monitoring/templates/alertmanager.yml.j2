
global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: '{{ alert_email_from }}'
  smtp_auth_username: '{{ alert_email_from }}'
  smtp_auth_password: '{{ alert_email_password }}'
  smtp_require_tls: true

route:
  receiver: email
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: email
    email_configs:
      - to: '{{ alert_email_to }}'
        send_resolved: true
